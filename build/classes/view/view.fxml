<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.9" xmlns:fx="http://javafx.com/fxml/1" fx:controller="segundaparcialmarchettaagustin.controller.ViewController">
   <children>
      <AnchorPane prefHeight="400.0" prefWidth="600.0">
         <children>
            <ListView fx:id="listviewObjetos" layoutX="14.0" layoutY="14.0" prefHeight="254.0" prefWidth="573.0" />
            <Button fx:id="btnAgregar" layoutX="14.0" layoutY="300.0" mnemonicParsing="false" onAction="#agregar" prefHeight="62.0" prefWidth="135.0" text="AGREGAR">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnModificar" layoutX="157.0" layoutY="300.0" mnemonicParsing="false" onAction="#modificar" prefHeight="62.0" prefWidth="135.0" text="MODIFICAR">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnEliminar" layoutX="301.0" layoutY="300.0" mnemonicParsing="false" onAction="#eliminar" prefHeight="62.0" prefWidth="135.0" text="ELIMINAR">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnRobotsBajaEnergia" layoutX="452.0" layoutY="300.0" mnemonicParsing="false" onAction="#mostrarRobotsBajaEnergia" prefHeight="62.0" prefWidth="135.0" text="POCA ENERGIA">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
