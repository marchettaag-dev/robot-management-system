<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="496.0" xmlns="http://javafx.com/javafx/21.0.9" xmlns:fx="http://javafx.com/fxml/1" fx:controller="segundaparcialmarchettaagustin.controller.FormularioController">
   <children>
      <AnchorPane prefHeight="400.0" prefWidth="552.0">
         <children>
            <Button fx:id="btnConfirmar" layoutX="147.0" layoutY="317.0" mnemonicParsing="false" onAction="#confirmar" prefHeight="49.0" prefWidth="132.0" text="CONFIRMAR">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <TextField fx:id="txfNombre" layoutX="332.0" layoutY="50.0" />
            <Label fx:id="lblSeleccion" layoutX="85.0" layoutY="151.0" prefHeight="25.0" prefWidth="194.0" text="Seleccione el tipo de ROBOT:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <RadioButton fx:id="rbDomestico" layoutX="118.0" layoutY="184.0" mnemonicParsing="false" onAction="#actualizarLabel" text="Domestico">
               <toggleGroup>
                  <ToggleGroup fx:id="grupoRobot" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbIndustrial" layoutX="118.0" layoutY="210.0" mnemonicParsing="false" onAction="#actualizarLabel" text="Industrial" toggleGroup="$grupoRobot" />
            <Button fx:id="btnCancelar" layoutX="322.0" layoutY="317.0" mnemonicParsing="false" onAction="#cancelar" prefHeight="49.0" prefWidth="132.0" text="CANCELAR">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Label fx:id="lblNombre" layoutX="332.0" layoutY="25.0" prefHeight="25.0" prefWidth="74.0" text="Nombre:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txfNivelEnergia" layoutX="332.0" layoutY="109.0" />
            <Label fx:id="lbNivelEnergia" layoutX="332.0" layoutY="84.0" prefHeight="25.0" prefWidth="112.0" text="Nivel de Energia:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txfNumeroSerie" layoutX="332.0" layoutY="164.0" />
            <Label fx:id="lbNumeroSerie" layoutX="332.0" layoutY="139.0" prefHeight="25.0" prefWidth="125.0" text="Numero de serie:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txtDatoEspecifico" layoutX="332.0" layoutY="236.0" />
            <Label fx:id="lblActividad" layoutX="312.0" layoutY="211.0" prefHeight="25.0" prefWidth="213.0" text="Dato especial:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
